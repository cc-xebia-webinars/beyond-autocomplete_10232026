{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "claudeMdExcludes": [
    "**/!(0[1-4]-*)/CLAUDE.md",
    "**/!(0[1-4]-*)/AGENTS.md"
  ],
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "PowerShell(uv run pytest *)",
      "Bash(uv run ruff *)",
      "PowerShell(uv run ruff *)"
    ],
    "deny": [
      "Read(./README.md)",
      "Bash(git push *)",
      "PowerShell(git push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python .claude/hooks/protect_tests.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format --quiet"
          }
        ]
      }
    ]
  }
}
